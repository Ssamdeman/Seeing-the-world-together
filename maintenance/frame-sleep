#!/usr/bin/env bash
set -euo pipefail

# Turn off HDMI display at 02:00 or when invoked directly
XDG_RUNTIME_DIR=/run/user/1001 WAYLAND_DISPLAY=wayland-0 /usr/bin/wlr-randr --output HDMI-A-1 --off 2>/dev/null || true

# Stop ImmichFrame and Immich cleanly so Postgres flushes and Seagate drive can spin down to rest
docker compose -f /home/admin/frame/immichframe/docker-compose.yml stop >/dev/null 2>&1 || true
docker compose -f /home/admin/frame/immich/docker-compose.yml stop >/dev/null 2>&1 || true
sync
